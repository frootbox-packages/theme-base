{#
  A navigation of the theme (decision 0106) with up to two levels. The
  second level opens with <details>, without a script. An entry of the
  main navigation with the option "button" stands out as a button
  (decision 0188). Phone numbers keep their order in right-to-left
  languages. The footer uses the macro "link" for its columns. In the
  editing mode the navigation is marked to change it there (decision 0349).

    {% include '@theme/navigation.twig' with { items: navigation('main'), name: 'main', label: t('Main navigation') } %}
#}
{% macro link(item) %}
  {%- if item.url is null -%}
    <span class="base-nav__heading">{{ item.label }}</span>
  {%- else -%}
    {%- set classes = [(item.options.button ?? false) ? 'base-nav__button', not item.current and item.active ? 'is-active']|filter(name => name) -%}
    <a href="{{ item.url }}"{% if item.current %} aria-current="page"{% endif %}{% if classes %} class="{{ classes|join(' ') }}"{% endif %}{% if item.newWindow %} target="_blank" rel="noopener"{% endif %}{% if item.url starts with 'tel:' %} dir="ltr"{% endif %}>{{ item.label }}</a>
  {%- endif -%}
{% endmacro %}
{% if items %}
  <nav class="base-nav base-nav--{{ name }}" aria-label="{{ label }}"{{ navigation_attributes(name)|attributes }}>
    <ul class="base-nav__list">
      {% for item in items %}
        <li>
          {% if item.children %}
            <details class="base-nav__group" name="base-nav-{{ name }}">
              <summary{% if item.active %} class="is-active"{% endif %}>{{ item.label }}</summary>
              <ul>
                {% if item.url is not null %}<li>{{ _self.link(item) }}</li>{% endif %}
                {% for child in item.children %}<li>{{ _self.link(child) }}</li>{% endfor %}
              </ul>
            </details>
          {% else %}
            {{ _self.link(item) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}
