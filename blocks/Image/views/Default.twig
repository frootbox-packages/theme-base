{# frootbox
title: Image
description: An image from the media in a column, with a caption if you like.
group: media
keywords: [Photo, Graphic]
widget: true
fields:
  image: { type: image, label: Image, sizes: "(min-width: 72rem) 36rem, (min-width: 48rem) 50vw, 100vw" }
  caption: { type: text, label: Caption, optional: true }
#}
<figure class="base-image">{{ field('image') }}<figcaption>{{ field('caption') }}</figcaption></figure>
