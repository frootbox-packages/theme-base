{# frootbox
title: Button
description: A link as a button in a column.
group: teaser
keywords: [Link, Control]
widget: true
options:
  style:
    type: choice
    label: Style
    choices: { primary: Filled, secondary: Outlined }
    default: primary
fields:
  link: { type: link, label: Link }
#}
<p class="base-button base-button--{{ options.style }}">{{ field('link') }}</p>
