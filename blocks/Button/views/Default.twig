{# frootbox
title: Button
description: A link as a button in a column, for the next step a visitor should take. Not for lists of links; at most two buttons next to each other.
group: teaser
keywords: [Link, Control, Call to action, CTA]
widget: true
options:
  style:
    type: choice
    label: Style
    choices: { primary: Filled, secondary: Outlined }
    default: primary
fields:
  link: { type: link, label: Link }
# Content for the design page (decision 0206).
examples:
  - fields:
      link: { url: 'https://example.org/', text: 'To the shop' }
  - options: { style: secondary }
    fields:
      link: { url: 'https://example.org/', text: 'About us' }
#}
<p class="base-button base-button--{{ options.style }}">{{ field('link') }}</p>
