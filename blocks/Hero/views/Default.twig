{# frootbox
title: Without image
description: Heading, text and buttons without an image, in the middle or aligned to the start of the text.
options:
  align:
    type: choice
    label: Alignment
    choices: { centred: Centred, start: Aligned to the start }
    default: centred
  background:
    type: choice
    label: Background
    choices: { surface: Surface, primary: Main colour, none: None }
    default: surface
#}
<div class="base-hero base-full base-hero--{{ options.align }} base-hero--{{ options.background }}">
  <div class="base-hero__inner">
    <div class="base-hero__text">
      <p class="base-hero__eyebrow">{{ field('eyebrow') }}</p>
      {{ heading('title', 0, {class: 'base-hero__title'}) }}
      <p class="base-hero__lead">{{ field('text') }}</p>
      <p class="base-hero__actions"><span class="base-hero__primary">{{ field('primary') }}</span><span class="base-hero__secondary">{{ field('secondary') }}</span></p>
    </div>
  </div>
</div>
