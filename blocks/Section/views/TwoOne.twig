{# frootbox
title: Two thirds and one third
description: A wide column on the left, a narrow one on the right.
options:
  spacing:
    type: choice
    label: Spacing
    choices: { small: Small, medium: Medium, large: Large }
    default: medium
  background:
    type: choice
    label: Background
    choices: { none: None, surface: Surface, primary: Accent, dark: Dark }
    default: none
  jumpMark:
    type: text
    label: Jump mark
    description: A short name for the jump bar and for links to this place, e.g. For agencies. Leave empty for none.
    default: ''
#}
<section{{ {id: jump_mark()}|attributes }} class="base-section base-full base-section--{{ options.spacing }} base-section--{{ options.background }}">
  <div class="base-section__grid base-section__grid--two-one">
    <div class="base-section__column">{{ area('first') }}</div>
    <div class="base-section__column">{{ area('second') }}</div>
  </div>
</section>
