{# frootbox
title: One third and two thirds
description: A narrow column on the left, a wide one on the right.
options:
  spacing:
    type: choice
    label: Spacing
    choices: { small: Small, medium: Medium, large: Large }
    default: medium
  background:
    type: choice
    label: Background
    choices: { none: None, surface: Surface, primary: Accent }
    default: none
#}
<section class="base-section base-full base-section--{{ options.spacing }} base-section--{{ options.background }}">
  <div class="base-section__grid base-section__grid--one-two">
    <div class="base-section__column">{{ area('first') }}</div>
    <div class="base-section__column">{{ area('second') }}</div>
  </div>
</section>
