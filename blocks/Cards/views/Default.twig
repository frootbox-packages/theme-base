{# frootbox
title: Cards
description: Several teasers side by side, each with an image, a heading, a short text and a link, e.g. offers, rooms or articles. At most the chosen number of columns, fewer where there is less room. For a single teaser use image with text.
group: teaser
keywords: [Teasers, Tiles, Boxes, Overview, Grid, Offers]
options:
  columns:
    type: choice
    label: Columns at most
    choices: { three: Three, two: Two, four: Four }
fields:
  eyebrow: { type: headline, label: Eyebrow, optional: true, maxLength: 60, placeholder: "A few words above the heading" }
  title: { type: headline, label: Heading, optional: true, maxLength: 100, placeholder: "Our offers" }
  intro: { type: text, label: Introduction, optional: true, multiline: true, maxLength: 300, placeholder: "A sentence or two below the heading" }
  items:
    type: list
    label: Cards
    min: 2
    max: 12
    start: 3
    fields:
      image: { type: image, label: Image, optional: true, ratio: "3:2", sizes: "(min-width: 72rem) 24rem, (min-width: 40rem) 50vw, 100vw" }
      title: { type: headline, label: Heading, maxLength: 80, placeholder: "What the card is about" }
      text: { type: text, label: Text, optional: true, multiline: true, maxLength: 300, placeholder: "A sentence or two about it" }
      link: { type: link, label: Link, optional: true }
  link: { type: link, label: Link below, optional: true, description: "Leads on, e.g. to all offers" }
# Content for the design page (decision 0206).
examples:
  - fields:
      eyebrow: 'From the roastery'
      title: 'Our offers'
      intro: 'Coffee to take home, to learn and to share.'
      items:
        - { image: { sample: examples/beans.jpg, alt: 'Warm gradient from brown to cream' }, title: 'Coffee subscription', text: 'Fresh beans every two weeks, paused whenever you like.', link: { url: 'https://example.org/', text: Subscribe } }
        - { image: { sample: examples/tasting.jpg, alt: 'Blue circle on a green gradient' }, title: 'Roasting course', text: 'Four hours at the roaster, with your own batch to take home.', link: { url: 'https://example.org/', text: 'Book a place' } }
        - { image: { sample: examples/harbour.jpg, alt: 'Orange circle of light on deep blue' }, title: 'Café by the harbour', text: 'Espresso, cake and a view of the ships.', link: { url: 'https://example.org/', text: 'Opening hours' } }
      link: { url: 'https://example.org/', text: 'All offers' }
#}
<div class="base-cards base-cards--{{ options.columns }}">
  <div class="base-cards__head base-head">
    <p class="base-head__eyebrow">{{ field('eyebrow') }}</p>
    {{ heading('title', 0, {class: 'base-cards__title'}) }}
    <p class="base-head__intro">{{ field('intro') }}</p>
  </div>
  <ul class="base-cards__list">
    {% for item in field('items') %}
      <li class="base-cards__item">
        <div class="base-cards__media">{{ item.field('image') }}</div>
        <div class="base-cards__body">
          {{ item.heading('title', 1, {class: 'base-cards__heading'}) }}
          <p class="base-cards__text">{{ item.field('text') }}</p>
          <p class="base-cards__link">{{ item.field('link') }}</p>
        </div>
      </li>
    {% endfor %}
  </ul>
  <p class="base-more">{{ field('link') }}</p>
</div>
