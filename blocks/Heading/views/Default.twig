{# frootbox
title: Heading
description: A heading in a column. Its level follows from where it stands. Not for the title of the page, that comes from the layout; for a heading with text in the main area use text with heading.
group: heading
keywords: [Title, Headline, Subheading]
widget: true
options:
  role:
    type: choice
    label: Role
    choices: { heading: Heading, sub: Subheading }
    default: heading
  size:
    type: choice
    label: Size
    choices: { auto: Automatic, large: Large, medium: Medium, small: Small }
    default: auto
fields:
  text: { type: headline, label: Heading }
#}
{# The widget has no main heading of its own: rank 0 stands at the level of its column, rank 2 one below. #}
{% set size = options.size == 'auto' ? (options.role == 'sub' ? 'medium' : 'large') : options.size %}
{{ heading('text', options.role == 'sub' ? 2 : 0, {class: 'base-heading base-heading--' ~ size}) }}
